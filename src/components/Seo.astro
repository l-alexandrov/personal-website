---
// Title, description, canonical URL, Open Graph and Twitter tags for every page.
import { site, siteDescription } from "../site";

interface Props {
  // Page title; omit on the home page to use the full site title.
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { title, noindex = false } = Astro.props;
const description = Astro.props.description ?? (await siteDescription());
const fullTitle = title ? `${title} | ${site.name}` : site.title;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const image = new URL(site.image.src, Astro.site).href;
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}

<meta property="og:type" content="website" />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content={String(site.image.width)} />
<meta property="og:image:height" content={String(site.image.height)} />
<meta property="og:image:alt" content={site.image.alt} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:creator" content={site.twitter} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content={site.image.alt} />
