---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <span>© {year} Lyuboslav Alexandrov</span>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: 32px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  .wrap {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    justify-content: space-between;
  }
</style>
