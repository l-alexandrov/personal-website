---
// A post's tags. Plain labels while tag pages are off; links to each tag's post list once
// `tagPages` in src/blog.ts is on. A tag with no letters or digits has no page, so it stays a label.
import { tagPages, tagPath, tagSlug, ui, type Locale } from "../../blog";

interface Props {
  tags: string[];
  locale: Locale;
}

const { tags, locale } = Astro.props;
---

{
  tags.length > 0 && (
    <ul class="tags" aria-label={ui[locale].tags}>
      {tags.map((tag) => (
        <li>{tagPages && tagSlug(tag) ? <a href={tagPath(locale, tag)}>{tag}</a> : tag}</li>
      ))}
    </ul>
  )
}

<style>
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
  }

  /* The link sits above a card's stretched title link, so it stays clickable. */
  li,
  a {
    display: inline-block;
    padding: 2px 10px;
    border: 1px solid var(--line);
    border-radius: 4px;
  }

  li:has(a) {
    padding: 0;
    border: 0;
  }

  a {
    position: relative;
    z-index: 1;
    color: inherit;
    text-decoration: none;
  }

  a:hover {
    color: var(--heading);
    border-color: var(--primary);
  }
</style>
