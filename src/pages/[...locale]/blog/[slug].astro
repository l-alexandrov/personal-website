---
// One post, at /blog/<slug>/ or /bg/blog/<slug>/, with links to its translations.
import { render } from "astro:content";
import { Image, getImage } from "astro:assets";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import {
  blogPath,
  formatDate,
  getPosts,
  getTranslations,
  localeParam,
  postLocale,
  postPath,
  postSlug,
  ui,
  type Post,
} from "../../../blog";
import { site } from "../../../site";

export async function getStaticPaths() {
  return (await getPosts()).map((post) => ({
    params: { locale: localeParam(postLocale(post)), slug: postSlug(post) },
    props: { post },
  }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, description, date, updated, image, imageAlt = "", tags } = post.data;
const locale = postLocale(post);
const t = ui[locale];
const { Content } = await render(post);
const translations = await getTranslations(post);
const url = new URL(postPath(post), Astro.site).href;

// The cover doubles as the share image, as a JPEG at most 1200px wide.
const share = image && (await getImage({ src: image, width: Math.min(image.width, 1200), format: "jpg" }));
const shareImage = share && {
  src: share.src,
  width: Number(share.attributes.width),
  height: Number(share.attributes.height),
  alt: imageAlt,
};

const schema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  datePublished: date.toISOString(),
  ...(updated && { dateModified: updated.toISOString() }),
  inLanguage: locale,
  url,
  mainEntityOfPage: url,
  image: new URL(shareImage ? shareImage.src : site.image.src, Astro.site).href,
  author: { "@type": "Person", name: site.name, url: Astro.site?.href },
  ...(tags.length > 0 && { keywords: tags.join(", ") }),
};
// Escape "<" so the JSON can never close the script element early.
const json = JSON.stringify(schema).replace(/</g, "\\u003c");
---

<BaseLayout
  title={title}
  description={description}
  lang={locale}
  image={shareImage}
  article={{ published: date, modified: updated, tags }}
  alternates={translations.map((translation) => ({ lang: postLocale(translation), href: postPath(translation) }))}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={json} />
    <link rel="alternate" type="application/rss+xml" title={`${t.blog} | ${t.rss}`} href={`${blogPath(locale)}rss.xml`} />
  </Fragment>

  <article class="wrap post">
    <header class="stack head">
      <a class="back" href={blogPath(locale)}>← {t.allPosts}</a>
      <p class="meta">
        <time datetime={date.toISOString()}>{formatDate(date, locale)}</time>
        {
          updated && (
            <span>
              · {t.updated} <time datetime={updated.toISOString()}>{formatDate(updated, locale)}</time>
            </span>
          )
        }
      </p>
      <h1>{title}</h1>
      <p class="lede">{description}</p>
      {
        translations.length > 0 && (
          <ul class="translations">
            {translations.map((translation) => (
              <li>
                <a href={postPath(translation)} hreflang={postLocale(translation)} lang={postLocale(translation)}>
                  {ui[postLocale(translation)].readIn}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </header>

    {
      image && (
        <Image
          class="cover"
          src={image}
          alt={imageAlt}
          widths={[480, 720, 960, 1440].filter((width) => width <= image.width)}
          sizes="(min-width: 800px) 760px, calc(100vw - 32px)"
          loading="eager"
          fetchpriority="high"
        />
      )
    }

    <div class="prose">
      <Content />
    </div>

    {
      tags.length > 0 && (
        <footer class="tags">
          <h2 class="sr-only">{t.tags}</h2>
          <ul>
            {tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
        </footer>
      )
    }
  </article>
</BaseLayout>

<style>
  .post {
    --measure: 760px;
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding-block: clamp(40px, 7vw, 80px);
  }

  .post > * {
    width: 100%;
    max-width: var(--measure);
    margin-inline: auto;
  }

  .head {
    --gap: 12px;
  }

  .back {
    align-self: flex-start;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    text-decoration: none;
  }

  .meta {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--muted);
  }

  h1 {
    font-size: clamp(2rem, 4.5vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.035em;
  }

  .lede {
    font-size: clamp(1.0625rem, 1.6vw, 1.1875rem);
    color: var(--muted);
  }

  .translations {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }

  .cover {
    height: auto;
    border-radius: var(--radius);
    border: 1px solid var(--line);
  }

  .tags ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    margin: 0;
    padding: 20px 0 0;
    border-top: 1px solid var(--line);
  }

  .tags li {
    padding: 4px 10px;
    border-radius: var(--radius-sm);
    background: var(--surface-2);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--muted);
  }

  /* Markdown body. The elements come from <Content />, so they need :global(). */
  .prose {
    font-size: 1.0625rem;
    line-height: 1.75;
  }

  .prose > :global(* + *) {
    margin-top: 1.25em;
  }

  .prose :global(h2) {
    margin-top: 2em;
    font-size: clamp(1.375rem, 2.4vw, 1.75rem);
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .prose :global(h3) {
    margin-top: 1.75em;
    font-size: 1.25rem;
    font-weight: 600;
  }

  .prose :global(:is(h2, h3) + *) {
    margin-top: 0.75em;
  }

  .prose :global(:is(ul, ol)) {
    padding-left: 1.4em;
  }

  .prose :global(li + li) {
    margin-top: 0.4em;
  }

  .prose :global(blockquote) {
    padding-left: 1em;
    border-left: 3px solid var(--primary);
    color: var(--muted);
  }

  .prose :global(img) {
    height: auto;
    border-radius: var(--radius-sm);
  }

  .prose :global(hr) {
    border: 0;
    border-top: 1px solid var(--line);
  }

  .prose :global(:not(pre) > code) {
    padding: 0.1em 0.35em;
    border-radius: 4px;
    background: var(--surface-2);
    font-family: var(--font-mono);
    font-size: 0.875em;
    overflow-wrap: anywhere;
  }

  /* Code blocks keep Shiki's github-dark colours on the site's code background, in both themes. */
  .prose :global(pre) {
    padding: 18px 20px;
    border: 1px solid var(--code-line);
    border-radius: var(--radius-sm);
    background: var(--code-bg) !important;
    color: var(--code-fg);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: 1.6;
    overflow-x: auto;
  }

  .prose :global(pre code) {
    font-family: inherit;
  }

  .prose :global(table) {
    display: block;
    max-width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
  }

  .prose :global(:is(th, td)) {
    padding: 8px 12px;
    border: 1px solid var(--line);
    text-align: left;
  }
</style>
