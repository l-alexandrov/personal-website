---
import { getEntry, render } from "astro:content";
import Section from "../Section.astro";

const about = await getEntry("about", "about");
if (!about) throw new Error("Missing src/content/home/about.md");
const { Content } = await render(about);
---

<Section id="about" title={about.data.title} glyph="hexa" color="red">
  <div class="about">
    <blockquote><p>{about.data.quote}</p></blockquote>
    <div class="body stack"><Content /></div>
  </div>
</Section>

<style>
  .about {
    display: grid;
    gap: 24px 56px;
  }

  blockquote {
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    line-height: 1.45;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--heading);
  }

  @media (min-width: 860px) {
    .about {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    }
  }
</style>
