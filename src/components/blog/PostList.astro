---
// Post cards in two columns, with the first post full width when `lead` is set.
import type { Post } from "../../blog";
import PostCard from "./PostCard.astro";

interface Props {
  posts: Post[];
  heading?: "h2" | "h3";
  lead?: boolean;
}

const { posts, heading, lead = false } = Astro.props;
---

<ul class="post-list">
  {
    posts.map((post, i) => (
      <li class:list={{ lead: lead && i === 0 }}>
        <PostCard post={post} heading={heading} lead={lead && i === 0} />
      </li>
    ))
  }
</ul>

<style>
  .post-list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 20px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (min-width: 760px) {
    .post-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 24px;
    }

    .lead {
      grid-column: 1 / -1;
    }
  }
</style>
